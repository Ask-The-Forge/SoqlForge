# Signing material — NEVER commit these.
# Updater keypair:
*.key
*.key.pub
# Apple code-signing certificates and anything derived from them. A .p12
# carries the private key; treat it like a password.
*.p12
*.pfx
*.cer
*.certSigningRequest
*.mobileprovision
*.p12.base64
*.p8

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local agent tooling config
.claude/

# Local app screenshots — kept out of the repo on purpose. They're captures of
# a dev org's sample data, not build inputs; nothing references them.
screenshots/
