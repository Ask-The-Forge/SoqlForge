{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoqlForge",
  "version": "0.1.3",
  "identifier": "com.soqlforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoqlForge",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ask-The-Forge/SoqlForge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Ask the Forge",
    "copyright": "Copyright (c) 2026 Ask the Forge",
    "category": "DeveloperTool",
    "shortDescription": "A SOQL desktop client for the Salesforce CLI",
    "longDescription": "SoqlForge is a desktop SOQL workspace for Windows that drives the Salesforce CLI (sf) as its backend. Multiple query tabs, schema-aware autocomplete with relationship traversal, inline cell editing, optional NL->SOQL assist, and CSV export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US",
        "upgradeCode": "5d5b3f76-4f4a-4d63-b5dc-7f3f7e0a3f25"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
